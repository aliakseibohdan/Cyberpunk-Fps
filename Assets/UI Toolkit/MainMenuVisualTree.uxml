<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=bdb23c2899186754686ca49385542ed3&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="DisclaimerContainer" class="menu-container" style="flex-grow: 1; display: none; opacity: 0; visibility: visible; width: 700px; height: 300px;">
        <engine:Label text="NOTICE OF PROPRIETARY OWNERSHIP AND RESTRICTED ACCESS" name="Title" style="align-self: center; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Art/UI/Fonts/uni-sans/Uni%20Sans%20Heavy.otf?fileID=12800000&amp;guid=9e78360efe2840a4aa74c136fa66588b&amp;type=3#Uni Sans Heavy&quot;); color: rgb(174, 255, 245); margin-top: 20px;" />
        <engine:Label text="&lt;align=justified&gt;This terminal and all connected systems, including but not limited to the Argus Battlefield Network, Oracle Core AI, and all A-0 Series platform data-feeds, are the sole and exclusive property of Aegis Dynamics.&#10;&#10;Access is permitted ONLY to personnel with active Omega-Prime security clearances, and is restricted to official, company-sanctioned business. Any unauthorized access, use, disclosure, or duplication of the information contained within this system is strictly prohibited.&#10;&#10;WARNING:&#10;This system is subject to 24/7 monitoring, packet-level inspection, and neural-activity scanning of all users. All activity is logged, archived, and subject to real-time analysis by Aegis Counterintelligence (ACI).&#10;&#10;By proceeding, you acknowledge that any violation of Aegis Dynamics Security Protocols will be considered an act of industrial espionage and/or treason against the corporation. Violators will be prosecuted to the fullest extent of corporate, national, and international law. Aegis Dynamics reserves the right to employ immediate and decisive asset-retrieval protocols, including lethal force, to protect its intellectual property and operational security.&#10;&#10;Unauthorized access is not a victimless crime. It is an act of war." name="Message1" style="-unity-font-definition: url(&quot;project://database/Assets/Art/UI/Fonts/uni-sans/Uni%20Sans%20Thin.otf?fileID=12800000&amp;guid=d9a79cb9a4b0300499ed86a9a6e0d581&amp;type=3#Uni Sans Thin&quot;); -unity-text-align: middle-center; color: rgb(174, 255, 245); white-space: normal; font-size: 9px; width: 650px; height: 190px; left: auto; align-self: center; align-items: stretch; justify-content: center;" />
        <engine:Button text="[I HAVE READ, UNDERSTAND, AND CONSENT TO THESE TERMS]" name="ConsentButton" class="optionButton" />
    </engine:VisualElement>
    <engine:VisualElement name="MainMenuContainer" class="menu-container" style="flex-grow: 1; display: flex; opacity: 1; visibility: visible; overflow: visible; position: absolute; width: 650px; height: 300px; align-self: center; right: auto;">
        <engine:Label text="CHROME &#10;FLESH" name="Title" class="header" style="display: flex; align-self: center;" />
        <engine:VisualElement name="Icon" style="flex-grow: 1; width: 4%; height: 4%; background-image: url(&quot;project://database/Assets/ThirdParty/free-cyberpunk-game-icons-for-ui/PNG/glitch%20effect/without%20background/46.png?fileID=2800000&amp;guid=d2d57ea7e58041741bd6f592a998fdc9&amp;type=3#46&quot;); background-size: 14px 14px; left: 6px; top: 20px; -unity-background-image-tint-color: rgb(174, 255, 205); align-self: flex-start;">
            <engine:Button text="Deploy New Unit" name="NewGameButton" enabled="true" class="button" style="top: 13px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); display: flex; left: 150px;" />
        </engine:VisualElement>
        <engine:VisualElement name="Icon" style="flex-grow: 1; width: 4%; height: 4%; background-image: url(&quot;project://database/Assets/ThirdParty/free-cyberpunk-game-icons-for-ui/PNG/glitch%20effect/without%20background/45.png?fileID=2800000&amp;guid=0bf9009019a29964fa5918d5a14e1614&amp;type=3#45&quot;); background-size: 14px 14px; left: 6px; top: 10px; -unity-background-image-tint-color: rgb(174, 255, 205); align-self: flex-start;">
            <engine:Button text="Connect to Deployed Unit" name="ContinueGameButton" class="button" style="top: 13px; left: 150px;" />
        </engine:VisualElement>
        <engine:VisualElement name="Icon" style="flex-grow: 1; width: 4%; height: 4%; background-image: url(&quot;project://database/Assets/ThirdParty/free-cyberpunk-game-icons-for-ui/PNG/glitch%20effect/without%20background/20.png?fileID=2800000&amp;guid=c20c05894d4928149a48bb0369abb63e&amp;type=3#20&quot;); background-size: 14px 14px; left: 6px; top: 0; -unity-background-image-tint-color: rgb(174, 255, 205); align-self: flex-start;">
            <engine:Button text="System Calibration" name="SettingsButton" class="button" style="top: 13px; left: 150px;" />
        </engine:VisualElement>
        <engine:VisualElement name="Icon" style="flex-grow: 1; width: 4%; height: 4%; background-image: url(&quot;project://database/Assets/ThirdParty/free-cyberpunk-game-icons-for-ui/PNG/glitch%20effect/without%20background/18.png?fileID=2800000&amp;guid=cde350c364dbc5e4099309de0fe1df78&amp;type=3#18&quot;); background-size: 14px 14px; left: 6px; top: -10px; -unity-background-image-tint-color: rgb(174, 255, 205); align-self: flex-start;">
            <engine:Button text="Personnel Records" name="CreditsButton" class="button" style="top: 13px; left: 150px;" />
        </engine:VisualElement>
        <engine:VisualElement name="Icon" style="flex-grow: 1; width: 4%; height: 4%; background-image: url(&quot;project://database/Assets/ThirdParty/free-cyberpunk-game-icons-for-ui/PNG/glitch%20effect/without%20background/26.png?fileID=2800000&amp;guid=f07c1402f7836344b92354d08d4b712b&amp;type=3#26&quot;); background-size: 14px 14px; left: 6px; top: 0; -unity-background-image-tint-color: rgb(174, 255, 205); align-self: flex-start;">
            <engine:Button text="Sever Link" name="ExitButton" class="button" style="top: 13px; left: 150px;" />
        </engine:VisualElement>
    </engine:VisualElement>
